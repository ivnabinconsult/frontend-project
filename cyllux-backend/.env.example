# ── Server ──────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database ─────────────────────────────────────────
# Local:
MONGO_URI=mongodb://127.0.0.1:27017/cyllux_homes
# Atlas (production):
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/cyllux_homes?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────
# Set to your frontend URL in production
CORS_ORIGIN=http://localhost:5500

# ── Email (contact form) ─────────────────────────────
# Uses Nodemailer. Fill in to enable real email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
CONTACT_RECEIVER=hello@cylluxhomes.com

# ── Admin Seed ───────────────────────────────────────
ADMIN_EMAIL=admin@cylluxhomes.com
ADMIN_PASSWORD=Admin@1234!
